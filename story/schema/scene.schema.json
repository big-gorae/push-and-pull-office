{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scene.schema.json",
  "title": "Love Office Scene",
  "type": "object",
  "required": ["schema_version", "id", "title", "route", "purpose", "cast", "state_contract", "start_node", "nodes"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.]*$"},
    "title": {"type": "string", "minLength": 1},
    "route": {"type": "string", "pattern": "^[a-z][a-z0-9_.]*$"},
    "chapter": {"type": "integer", "minimum": 0},
    "sequence": {"type": "integer", "minimum": 0},
    "location": {"type": "string"},
    "time": {"type": "string"},
    "default_background": {"$ref": "#/$defs/background_cue"},
    "purpose": {"type": "string", "minLength": 1},
    "cast": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "world_context": {"$ref": "world-context.schema.json"},
    "entry_conditions": {"type": "array", "items": {"$ref": "#/$defs/condition"}},
    "state_contract": {
      "type": "object",
      "required": ["reads", "writes"],
      "properties": {
        "reads": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "writes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "start_node": {"type": "string"},
    "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}}
  },
  "$defs": {
    "condition": {
      "type": "object",
      "required": ["path", "op"],
      "properties": {
        "path": {"type": "string"},
        "op": {"enum": ["eq", "ne", "gt", "gte", "lt", "lte", "contains", "not_contains", "exists", "not_exists"]},
        "value": {}
      },
      "additionalProperties": false
    },
    "effect": {
      "type": "object",
      "required": ["path", "op", "value"],
      "properties": {
        "path": {"type": "string"},
        "op": {"enum": ["set", "add", "append_unique", "remove"]},
        "value": {},
        "conditions": {"type": "array", "items": {"$ref": "#/$defs/condition"}}
      },
      "additionalProperties": false
    },
    "background_cue": {
      "type": "object",
      "required": ["visual_id", "variant_id"],
      "properties": {
        "visual_id": {"type": "string"},
        "variant_id": {"type": "string"}
      },
      "additionalProperties": false
    },
    "stage_cue": {
      "type": "object",
      "required": ["position", "character", "visual_id", "artwork"],
      "properties": {
        "position": {"enum": ["left", "center", "right"]},
        "character": {"type": "string"},
        "visual_id": {"type": "string"},
        "artwork": {"type": "string"}
      },
      "additionalProperties": false
    },
    "option": {
      "type": "object",
      "required": ["id", "label", "interpretation", "action", "push_pull", "conditions", "effects", "next"],
      "properties": {
        "id": {"type": "string"},
        "label": {"type": "string"},
        "interpretation": {"type": "string"},
        "action": {"type": "string"},
        "push_pull": {"$ref": "#/$defs/push_pull"},
        "interaction": {"$ref": "#/$defs/interaction"},
        "self_development": {"$ref": "#/$defs/self_development_choice"},
        "conditions": {"type": "array", "items": {"$ref": "#/$defs/condition"}},
        "effects": {"type": "array", "items": {"$ref": "#/$defs/effect"}},
        "next": {"type": "string"}
      },
      "additionalProperties": false
    },
    "interaction": {
      "type": "object",
      "required": ["target", "support_styles"],
      "properties": {
        "target": {"type": "string", "pattern": "^[a-z][a-z0-9_.]*$"},
        "support_styles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "emotional_validation",
              "factual_clarification",
              "practical_resolution",
              "ask_before_helping",
              "autonomy_return",
              "concise_reassurance",
              "literal_respect"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "interaction_context": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["support", "coordination", "boundary", "not_applicable"]}
      },
      "additionalProperties": false
    },
    "analysis_hints": {
      "type": "object",
      "required": ["pull", "push", "none"],
      "properties": {
        "pull": {"type": "string", "minLength": 1},
        "push": {"type": "string", "minLength": 1},
        "none": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "self_development_choice": {
      "type": "object",
      "required": ["expression", "equivalent_to", "converges_at"],
      "properties": {
        "expression": {"type": "string", "pattern": "^[a-z][a-z0-9_.]*$"},
        "equivalent_to": {"type": "string", "pattern": "^[a-z][a-z0-9_.]*$"},
        "converges_at": {"type": "string", "pattern": "^[a-z][a-z0-9_.]*$"}
      },
      "additionalProperties": false
    },
    "self_development_variant": {
      "type": "object",
      "required": ["expression"],
      "properties": {
        "expression": {"type": "string", "pattern": "^[a-z][a-z0-9_.]*$"}
      },
      "additionalProperties": false
    },
    "push_pull": {
      "type": "object",
      "required": ["action", "intensity", "base_score"],
      "properties": {
        "target": {"type": "string", "pattern": "^[a-z][a-z0-9_.]*$"},
        "action": {"enum": ["approach", "space", "literal"]},
        "intensity": {"type": "integer", "minimum": 8, "maximum": 16},
        "base_score": {"type": "integer", "minimum": 2, "maximum": 5}
      },
      "additionalProperties": false
    },
    "transition": {
      "type": "object",
      "properties": {
        "conditions": {"type": "array", "items": {"$ref": "#/$defs/condition"}},
        "default": {"type": "boolean"},
        "node": {"type": "string"},
        "scene": {"type": "string"},
        "ending": {"type": "boolean"},
        "ending_id": {"type": "string"}
      }
    },
    "dialogue_variant": {
      "type": "object",
      "required": ["id", "line"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.]*$"},
        "priority": {"type": "integer"},
        "conditions": {"type": "array", "items": {"$ref": "#/$defs/condition"}},
        "default": {"type": "boolean"},
        "self_development": {"$ref": "#/$defs/self_development_variant"},
        "expression": {"type": "string"},
        "line": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.]*$"},
        "kind": {"enum": ["dialogue", "narration", "silent", "choice", "state_gate", "effect", "exit"]},
        "analysis_hints": {"$ref": "#/$defs/analysis_hints"},
        "interaction_context": {"$ref": "#/$defs/interaction_context"},
        "speaker": {"type": "string"},
        "presentation_flags": {"type": "array", "items": {"type": "string"}},
        "expression": {"type": "string"},
        "line": {"type": "string"},
        "variants": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/dialogue_variant"}},
        "stage": {"type": "array", "items": {"$ref": "#/$defs/stage_cue"}},
        "prompt": {"type": "string"},
        "stimulus": {"type": "string", "minLength": 1},
        "options": {"type": "array", "items": {"$ref": "#/$defs/option"}},
        "effects": {"type": "array", "items": {"$ref": "#/$defs/effect"}},
        "transitions": {"type": "array", "items": {"$ref": "#/$defs/transition"}},
        "next": {"type": "string"}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "dialogue"}}}, "then": {
          "required": ["speaker", "next"],
          "oneOf": [{"required": ["line"]}, {"required": ["variants"]}]
        }},
        {"if": {"properties": {"kind": {"const": "narration"}}}, "then": {
          "required": ["next"],
          "oneOf": [{"required": ["line"]}, {"required": ["variants"]}]
        }},
        {"if": {"properties": {"kind": {"const": "silent"}}}, "then": {"required": ["line", "next"]}},
        {"if": {"properties": {"kind": {"const": "choice"}}}, "then": {"required": ["interaction_context", "prompt", "stimulus", "options"]}},
        {"if": {"properties": {"kind": {"const": "state_gate"}}}, "then": {"required": ["transitions"]}},
        {"if": {"properties": {"kind": {"const": "effect"}}}, "then": {"required": ["effects", "next"]}},
        {"if": {"properties": {"kind": {"const": "exit"}}}, "then": {"required": ["transitions"]}},
        {"if": {"required": ["analysis_hints"]}, "then": {
          "properties": {"kind": {"const": "choice"}}
        }}
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
