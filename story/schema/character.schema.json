{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "character.schema.json",
  "title": "Love Office Character",
  "type": "object",
  "required": ["schema_version", "id", "display_name", "age", "role", "narrative_role", "summary", "voice", "visual", "expressions"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.]*$"},
    "display_name": {"type": "string", "minLength": 1},
    "age": {"type": "integer", "minimum": 18},
    "role": {"type": "string"},
    "narrative_role": {"type": "string"},
    "summary": {"type": "string"},
    "immutable_facts": {"type": "array", "items": {"type": "string"}},
    "voice": {"type": "object"},
    "visual": {"type": "object"},
    "interaction_preferences": {
      "type": "object",
      "required": ["support_order", "prefers", "resists", "context_overrides"],
      "properties": {
        "authoring_shorthand": {"type": "string", "minLength": 1},
        "support_order": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "emotional_validation",
              "factual_clarification",
              "practical_resolution",
              "ask_before_helping",
              "autonomy_return",
              "concise_reassurance",
              "literal_respect"
            ]
          }
        },
        "prefers": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "resists": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "context_overrides": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "expressions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["emotion", "description"],
        "properties": {
          "emotion": {"type": "string"},
          "description": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "emotion_rules": {"type": "array"},
    "reporting_rules": {"type": "array"},
    "relationships": {"type": "object"}
  },
  "additionalProperties": false
}
