{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "밀당 오피스 스토리 에디터",
  "version": "0.1.0",
  "identifier": "com.pushandpulloffice.storyeditor",
  "build": {
    "beforeDevCommand": "npm run dev:editor",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "밀당 오피스 · 스토리 에디터",
        "width": 1480,
        "height": 940,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
