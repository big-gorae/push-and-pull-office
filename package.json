{
  "name": "push-and-pull-office-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "VITE_APP_SURFACE=game vite --host 127.0.0.1 --port 1420",
    "dev:editor": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc && vite build",
    "build:pages": "VITE_APP_SURFACE=game VITE_HOSTING_TARGET=github-pages npm run build",
    "build:site": "VITE_APP_SURFACE=game npm run build",
    "test:player": "vitest run src/player",
    "test:prompts": "vitest run src/prompt-builder",
    "test:prompt-harness": "node --test tools/prompt_harness.test.mjs",
    "test:e2e": "playwright test",
    "benchmark:editor": "node tools/benchmark_editor.mjs",
    "benchmark:editor-save": "PYTHONDONTWRITEBYTECODE=1 .venv/bin/python tools/benchmark_editor_save.py",
    "art:cutout": "node tools/image_cutout.mjs generate",
    "art:cutout:verify": "node tools/image_cutout.mjs verify",
    "prompt:harness": "node tools/prompt_harness.mjs",
    "prompt:validate": "node tools/prompt_harness.mjs validate",
    "verify": "bash tools/verify_all.sh all",
    "verify:story": "bash tools/verify_all.sh story",
    "verify:player": "bash tools/verify_all.sh player",
    "verify:e2e": "bash tools/verify_all.sh e2e",
    "prepare": "bash tools/install_git_hooks.sh",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.50.0",
    "@playwright/test": "1.62.1",
    "@tauri-apps/cli": "2.11.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "sharp": "0.35.2",
    "typescript": "7.0.2",
    "vite": "6.4.3",
    "vitest": "3.2.7",
    "wrangler": "4.118.0"
  },
  "overrides": {
    "undici": "7.29.0"
  }
}
